cabal-version:      3.0
name:               haskell-git
version:            0.1.0.0

synopsis:           Clone, inspect, and verify Git repositories
description:
    A Git implementation in Haskell. It clones over Smart HTTP, reads loose
    and packed objects, writes commits and trees, and checks repository
    integrity. The library exposes the object, pack, ref, index, and protocol
    layers.

license:            Apache-2.0
license-file:       LICENSE
author:             Meillaya
maintainer:         nathanagbomed@proton.me
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

extra-source-files:
    devenv.nix
    devenv.lock
    devenv.yaml
    docs/figures/*.excalidraw
    docs/figures/*.png
    docs/figures/gen_figures.py

source-repository head
    type:     git
    location: https://github.com/meillaya/haskell-git

common warnings
    ghc-options: -Wall

library
    import:           warnings

    exposed-modules:
        Git.Clone
        Git.Hash
        Git.Index
        Git.Object
        Git.Object.Blob
        Git.Object.Commit
        Git.Object.Loose
        Git.Object.Person
        Git.Object.Tag
        Git.Object.Tree
        Git.Pack
        Git.Pack.Delta
        Git.Pack.Index
        Git.Pack.Read
        Git.Protocol.PacketLine
        Git.Protocol.SmartHTTP
        Git.Refs
        Git.Repo
        Git.Store
        Git.Verify

    build-depends:
        base >=4.18 && <5,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.8,
        cryptohash-sha1 >=0.11 && <0.12,
        directory >=1.3.6 && <1.4,
        filepath >=1.4 && <1.6,
        http-conduit >=2.3 && <2.4,
        http-types >=0.12 && <0.13,
        time >=1.9 && <1.15,
        zlib >=0.6 && <0.9

    hs-source-dirs:   src

    default-language: Haskell2010

executable haskell-git
    import:           warnings

    main-is:          Main.hs
    other-modules:    Git.CLI

    build-depends:
        base >=4.18 && <5,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.8,
        directory >=1.3.6 && <1.4,
        filepath >=1.4 && <1.6,
        haskell-git,
        time >=1.9 && <1.15

    hs-source-dirs:   app

    default-language: Haskell2010

test-suite haskell-git-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        Git.CloneSpec
        Git.IndexSpec
        Git.InteropSpec
        Git.Object.BlobSpec
        Git.Object.CommitSpec
        Git.Object.TagSpec
        Git.Object.TreeSpec
        Git.Pack.DeltaSpec
        Git.Pack.IndexSpec
        Git.Pack.ReadSpec
        Git.PackSpec
        Git.Protocol.PacketLineSpec
        Git.Protocol.SmartHTTPSpec
        Git.RefsSpec
        Git.RepoSpec
        Git.StoreSpec
        Git.VerifySpec
        TestSupport

    build-depends:
        base >=4.18 && <5,
        bytestring >=0.11 && <0.13,
        directory >=1.3.6 && <1.4,
        filepath >=1.4 && <1.6,
        haskell-git,
        process >=1.6 && <1.7

    hs-source-dirs:   test

    default-language: Haskell2010
